# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_DB=precision_pulse
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ── Secrets (REQUIRED — generate with: python3 -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET=replace-with-64-char-hex-secret
SECRET_KEY=replace-with-64-char-hex-secret

# ── Frontend URLs (change to your server IP/domain in production) ─────────────
NEXT_PUBLIC_BACKEND_URL=http://localhost:5000
NEXT_PUBLIC_SOCKETIO_URL=http://localhost:5000

# ── Desktop streamer ──────────────────────────────────────────────────────────
DEVICE_ID=desktop-001
